# Fabrik3D public demo deployment profile (S48).
#
# The public demo is intentionally distinct from an on-premise install: it exposes the clearly
# labelled read-only public-demo identity and disables the support bundle. Never use this profile
# for training-centre production data.
#
# This is a NON-SECRET template; identity provider secrets are injected from the hosting platform.

Deployment__Profile=Demo
Deployment__SupportBundleEnabled=false

# The demo uses a dedicated, read-only identity provider (PublicDemo role enabled).
Authentication__Mode=Oidc
Authentication__Authority=
Authentication__Issuer=
Authentication__Audience=
Authentication__PublicDemoEnabled=true
Authentication__RequireHttpsMetadata=true

Cors__AllowedOrigins__0=https://demo.fabrik3d.example

OpcUa__Enabled=false
Mqtt__Enabled=false
Modbus__Enabled=false

Historian__Enabled=false
