# Fabrik3D production deployment profile (S48).
#
# This is a NON-SECRET template. Copy it to a private location, fill in the identity provider and
# secrets, then start the stack with:
#   docker compose -f Fabrik3D/compose.production.yaml --env-file <your-file> up --build -d

Deployment__Profile=Production
Deployment__SupportBundleEnabled=true
Deployment__BuildId=

# Management/administrator identity provider. Production refuses Development/Test/None modes.
Authentication__Mode=Oidc
Authentication__Authority=
Authentication__Issuer=
Authentication__Audience=
Authentication__RequireHttpsMetadata=true

# Explicit HTTPS origins only. Terminate TLS at your ingress or reverse proxy.
Cors__AllowedOrigins__0=https://fabrik3d.example.com

OpcUa__Enabled=false
Mqtt__Enabled=false
Modbus__Enabled=false

Historian__Enabled=true
