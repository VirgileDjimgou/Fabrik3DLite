# Fabrik3D on-premise deployment profile (S48).
#
# This is a NON-SECRET template. Copy it to a private location, fill in your identity provider and
# any secrets, then start the stack with:
#   docker compose -f Fabrik3D/compose.production.yaml --env-file <your-file> up --build -d
#
# Never commit a file that contains real credentials, tokens or keys.

# ── Deployment profile ──────────────────────────────────────────────────
Deployment__Profile=OnPrem
Deployment__SupportBundleEnabled=true
Deployment__BuildId=

# ── Identity (required) ─────────────────────────────────────────────────
# Production-like profiles refuse anonymous access. Configure your OIDC authority here.
Authentication__Mode=Oidc
Authentication__Authority=
Authentication__Issuer=
Authentication__Audience=
Authentication__RequireHttpsMetadata=true

# ── Browser CORS (explicit origins only; no wildcard) ───────────────────
Cors__AllowedOrigins__0=https://fabrik3d.example.internal

# ── Optional industrial connectors (disabled by default) ────────────────
OpcUa__Enabled=false
Mqtt__Enabled=false
Modbus__Enabled=false

# ── Historian retention (bounded storage) ───────────────────────────────
Historian__Enabled=true
Historian__RetentionMaxAgeDays=30
Historian__RetentionMaxSamplesPerSignal=200000
