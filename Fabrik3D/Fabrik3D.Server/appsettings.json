{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "Fabrik3D"
  },
  "Orchestration": {
    "HeartbeatTimeoutSeconds": 15,
    "HeartbeatCheckIntervalSeconds": 5,
    "AuthorityLeaseSeconds": 30,
    "RequireAuthorityConfirmation": true,
    "AuthorityConfirmationToken": null
  },
  "Authentication": {
    "Mode": "",
    "Authority": null,
    "Issuer": null,
    "Audience": null,
    "RequireHttpsMetadata": true,
    "SigningKey": null,
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30,
    "PublicDemoEnabled": false,
    "ValidateIssuer": true,
    "ValidateAudience": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Tenancy": {
    "Enabled": true,
    "SingleOrganization": true,
    "PlatformAdminEnabled": true
  },
  "Training": {
    "Enabled": true,
    "ServerAssessmentEnabled": true,
    "MaxBatchSize": 500,
    "MaxActionsPerSession": 5000,
    "MaxPageSize": 200
  },
  "SecurityHeaders": {
    "Enabled": true,
    "ContentTypeOptions": "nosniff",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "CrossOriginOpenerPolicy": "same-origin",
    "PermissionsPolicy": "geolocation=(), camera=(), microphone=()",
    "ContentSecurityPolicy": null
  },
  "OpcUa": { "Enabled": false, "Endpoint": "opc.tcp://localhost:4840", "SecurityPolicy": "Basic256Sha256", "CertificateTrustStore": "./data/opcua-trust", "ReconnectDelaySeconds": 5, "SamplingIntervalMilliseconds": 1000, "AllowWrites": false, "WriteAllowList": [] },
  "Mqtt": { "Enabled": false, "Broker": "mqtt://localhost:1883", "ClientId": "fabrik3d-orchestrator", "QoS": 1, "CleanSession": false, "SessionExpirySeconds": 3600, "ReconnectDelaySeconds": 5, "MaxReconnectDelaySeconds": 60, "ConnectTimeoutSeconds": 10, "KeepAliveSeconds": 30, "ProtocolVersion": "5.0", "UseTls": false, "AllowUntrustedCertificates": false, "AllowAnonymousBroker": true, "AllowWrites": false, "AllowRetainedCommands": false, "AllowRetainedTelemetry": true, "MaxPayloadBytes": 65536, "StaleAfterMilliseconds": 10000, "DuplicateWindowSize": 1024, "WillTopic": null, "TelemetryTopics": [], "CommandTopics": [], "CommandAllowList": [], "SignalMap": [] },
  "Modbus": { "Enabled": false, "Host": "127.0.0.1", "Port": 502, "UnitId": 1, "ConnectTimeoutMilliseconds": 5000, "RequestTimeoutMilliseconds": 2000, "PollIntervalMilliseconds": 1000, "ReconnectDelaySeconds": 5, "MaxReconnectDelaySeconds": 60, "StaleAfterMilliseconds": 10000, "AllowWrites": false, "WriteAllowList": [], "AddressConvention": "zero-based", "Points": [] },
  "Historian": {
    "Enabled": false,
    "MaxBatchSize": 500,
    "MaxEventBatchSize": 500,
    "MaxPayloadLength": 4096,
    "MaxSamplesPerMinutePerSource": 6000,
    "MaxBatchesPerMinutePerSource": 120,
    "DefaultSamplingMode": "on-change",
    "DefaultSamplingIntervalMilliseconds": 1000,
    "DefaultDeadband": 0,
    "SignalPolicies": [],
    "RetentionEnabled": true,
    "RetentionCheckIntervalMinutes": 15,
    "RetentionMaxAgeDays": 7,
    "RetentionMaxSamplesPerSignal": 200000,
    "RetentionMaxEventDocuments": 500000,
    "MaxQueryPageSize": 500
  }
}
